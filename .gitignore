# Node (frontend + backend)
node_modules/
dist/
.angular/
npm-debug.log*

# Frontend build copied into the backend at deploy time (see ./Dockerfile)
backend/public/

# Environment secrets — never commit these
.env
.env.local
*.env

# Python (sync-py)
backend/sync-py/venv/
backend/sync-py/__pycache__/
