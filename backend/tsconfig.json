{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "../shared/court/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/scripts/check-search-match.ts",
    "../shared/court/*.test.ts",
    "../shared/court/tune-shots.ts"
  ]
}
