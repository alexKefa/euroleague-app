{
  "name": "euroleague-app-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "sync:standings": "tsx src/sync/runSync.ts",
    "sync:news": "tsx src/sync/runNewsSync.ts",
    "sync:odds": "tsx src/sync/runOddsSync.ts",
    "economy:report": "tsx src/scripts/economy-report.ts",
    "economy:simulate": "tsx src/scripts/season-simulation.ts",
    "collectibles:expand": "tsx src/scripts/expand-collectibles.ts",
    "collectibles:expand-coaches": "tsx src/scripts/expand-coach-collectibles.ts",
    "fantasy:reprice": "tsx src/scripts/reprice-fantasy-players.ts",
    "seed:trade-marketplace": "tsx src/scripts/seed-trade-marketplace.ts",
    "promo:create": "tsx src/scripts/create-promo-code.ts",
    "check:rate-limit": "tsx src/scripts/check-rate-limit.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.4",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
