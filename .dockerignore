# Reinstalled fresh inside the Docker build (see Dockerfile) — including
# these in the upload context just bloats it for no reason. Without this
# file, `railway up`'s indexing step was hashing 30k+ node_modules files
# (~430MB across root/frontend/backend) plus .git on every deploy.
node_modules
frontend/node_modules
backend/node_modules

# Build output — regenerated in the container.
frontend/dist
frontend/.angular
backend/dist
backend/public

.git
.claude
.agents

.env
.env.local
*.env

.DS_Store
npm-debug.log*

# Not used by the Docker build (2026-09-30): the Windows-only Python venv
# for the local sync scripts (~169MB / ~7k files, copied in by
# `COPY backend/ ./` for nothing) and local production DB backups (~75MB,
# real user data that should never leave this machine). Both were being
# uploaded, indexed and unpacked on every `railway up`, a large part of the
# long "Initializing" step.
backend/src/sync-py/venv
backend/src/sync-py/__pycache__
backups
